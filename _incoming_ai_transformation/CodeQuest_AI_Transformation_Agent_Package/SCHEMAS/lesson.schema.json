{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codequest.example/schemas/lesson.schema.json",
  "title": "CodeQuest AI Lesson",
  "type": "object",
  "required": [
    "id",
    "objectiveIds",
    "title",
    "prerequisites",
    "sections",
    "guidedPractice",
    "independentPractice",
    "masteryCheck",
    "status",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "objectiveIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 3,
      "maximum": 180
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "body"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "altText": {
            "type": "string"
          }
        }
      }
    },
    "workedExamples": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "guidedPractice": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "independentPractice": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "masteryCheck": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reviewObjectiveIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "pilot",
        "published",
        "archived"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
